# Copy to .env and fill in. Never commit .env.
# Referenced from config/config.yaml via ${VAR} interpolation and by docker-compose.yml.

# Pi-hole v6 (Raspberry Pi)
PIHOLE_URL=http://172.20.1.41
PIHOLE_PASSWORD=change-me
# Optional: ssh alias/host used for `dnsstack update --apply` (runs `sudo pihole -up`)
PIHOLE_SSH_HOST=

# AdGuard Home (VM)
ADGUARD_URL=http://172.20.1.42:3000
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=change-me

# NextDNS (cloud)
NEXTDNS_PROFILE_ID=abc123
NEXTDNS_API_KEY=change-me
# Per-profile "Linked IP" update URL from the NextDNS Setup page
NEXTDNS_LINKED_IP_URL=https://link-ip.nextdns.io/abc123/xxxxxxxxxxxxxxxx

# Grafana admin password
GF_ADMIN_PASSWORD=change-me

# How often the sync service pushes lists to the servers (seconds)
SYNC_INTERVAL=3600
